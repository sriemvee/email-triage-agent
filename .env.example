EMAIL_TRIAGE_GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
EMAIL_TRIAGE_GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
EMAIL_TRIAGE_GMAIL_REFRESH_TOKEN=replace-after-running-gmail-auth
EMAIL_TRIAGE_MAILBOX=INBOX
EMAIL_TRIAGE_MAX_MESSAGES=50
EMAIL_TRIAGE_ALLOWLIST_SENDERS=vip@example.com
EMAIL_TRIAGE_ALLOWLIST_DOMAINS=trusted.com
EMAIL_TRIAGE_PROTECT_UNREAD=true
EMAIL_TRIAGE_IRRELEVANT_SENDERS=newsletter@example.com,deals@example.com
EMAIL_TRIAGE_IRRELEVANT_KEYWORDS=unsubscribe,newsletter,sale,discount,offer,promo
